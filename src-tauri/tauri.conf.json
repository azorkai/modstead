{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modstead",
  "version": "0.2.0",
  "identifier": "app.modstead",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Modstead",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0d10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://art.localhost art: https://staticdelivery.nexusmods.com https://images.steamusercontent.com https://steamuserimages-a.akamaihd.net https://modscontent.paradox-interactive.com http://127.0.0.1:47213 http://127.0.0.1:47214 http://127.0.0.1:47215",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Oyun mod yöneticisi",
    "longDescription": "MSFS, Bannerlord, Stardew Valley ve Cities: Skylines II modlarını tek yerden, güvenli indirme ve doğrulamayla yönetin.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3ODM2MDg3Qzg4NjQxQjEKUldTeFFZYkloMkNEbDdDNzVSSldzNk95S2YwaVJaanFZUW51S0Z1WnBqbzllODVueXV4Y2NSYzQK",
      "endpoints": ["https://github.com/azorkai/modstead/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
