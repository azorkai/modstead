<?xml version="1.0" encoding="Windows-1252"?>
<!--
  Modstead Kariyer panelinin tanımı: ../package/InGamePanels/modstead-career-hud.spb bu belgenin derlenmiş hâlidir.
  Boyutlar ekran yüksekliğinin yüzdesidir (genişlik de: 35 = yüksekliğin %35'i). Simin kendi panelleri: Görev adımları
  36×22, METAR 45×15, ATC 48×55. Değiştirilirse .spb yeniden derlenmeli (MSFS geliştirici kipi, SDK paket aracı ya da
  belgelenmiş SPB biçimine göre bir kodlayıcı) ve kariyer/hud.rs içindeki HUD_VERSION artırılmalı. Sim kullanıcının
  verdiği boyutu hatırlar; yeni varsayılan yalnızca panel ilk kez açılırken ya da yerleşim sıfırlanınca görünür.
-->
<SimBase.Document Type="InGamePanels" version="1,0">
  <Filename>modstead-career-hud.spb</Filename>
  <InGamePanels.InGamePanelDefinition
    id="PANEL_MODSTEAD_CAREER"
    Name="Modstead Career"
    url="html_ui/InGamePanels/ModsteadCareer/ModsteadCareer.html"
    resizeDirections="Both"
    minWidth="26"
    minHeight="26"
    defaultWidth="35"
    defaultHeight="37"
    defaultTop="12"
    defaultRight="2"
    icon="ICON_TOOLBAR_MODSTEAD_CAREER"
    buttonVisible="true" />
</SimBase.Document>
